{
  "name": "cards-against-cirelli",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm --filter @cirelli/web build && pnpm --filter @cirelli/server build",
    "e2e": "pnpm build && playwright test",
    "start": "node apps/server/dist/server.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
